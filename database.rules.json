{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "competitions": {
      "gm-advanced": {
        "$levelId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staffLead' || root.child('users').child(auth.uid).child('levelId').val() === $levelId)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staffLead' || root.child('users').child(auth.uid).child('levelId').val() === $levelId)"
        }
      }
    }
  }
}
